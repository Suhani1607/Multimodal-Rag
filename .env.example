# ==========================================
# AI DOCUMENT KNOWLEDGE PLATFORM ENVIRONMENT
# ==========================================

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# Cohere API Configuration (Optional Reranking)
COHERE_API_KEY=your_cohere_api_key_here
COHERE_RERANK_MODEL=rerank-english-v3.0

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge_platform
DATABASE_NAME=knowledge_platform
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage Configuration (Local filesystem or AWS S3)
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./storage/uploads
S3_BUCKET_NAME=your_s3_bucket_name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Internal Service-to-Service Security
INTERNAL_API_SECRET=super-secret-internal-token-change-in-prod
FASTAPI_URL=http://localhost:8000
VITE_API_URL=http://localhost:8080/api/v1
